# macOS 缓存与跨系统复制元数据
.DS_Store
._*
__MACOSX/
.AppleDouble/
.work/
**/node_modules
__pycache__/
*.pyc
.env
.env.*
!.env.example
secrets/
logs/
tmp/
dist/
build/
*.log
# 本阶段白名单内的原始验收日志需要随证据提交。
!outputs/pet-visual-20261029/**/*.log
!outputs/auto-recycle-20261029/**/*.log
!outputs/level-growth-20261029/**/*.log
!outputs/inventory-capacity-20261030/**/*.log
client/library/
client/temp/
client/profiles/
client/local/
client/native/
client/.creator/*
!client/.creator/default-meta.json
# Creator编辑器问卷服务缓存会自动刷新form标识，不是运行时开屏配置。
client/settings/v2/packages/information.json
# 从本机原客户端按原版音频来源清单导入，音频原件和对应导入元数据保存在本机。
client/assets/resources/audio/*.wav
client/assets/resources/audio/*.wav.meta
# 世界首领图集从现有本机帧生成，随实际构建发布。
client/assets/resources/development/world-boss-atlas/
client/assets/resources/development/world-boss-atlas.meta
# 切图图集按实际地图和职业可见范围从同一批本机原帧生成。
client/assets/resources/development/map-travel-atlas/
client/assets/resources/development/map-travel-atlas.meta
# 动作素材由本机原版资源生成，使用独立的可核对清单。
client/assets/resources/development/original-monsters/
client/assets/resources/development/original-monsters.meta
client/assets/resources/development/town-npcs/
client/assets/resources/development/town-npcs.meta
client/assets/resources/development/pets/shinsu/
client/assets/resources/development/pets/shinsu.meta
client/assets/resources/development/pets.meta
# 区域地表由本机原地图和瓦片库生成，包含独立 Creator 导入元数据。
client/assets/resources/development/map-styles/
client/assets/resources/development/map-styles.meta
server/minimir
outputs/server-dev/nbserver
conf/dev/*.local.json

